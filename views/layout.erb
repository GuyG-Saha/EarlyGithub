<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>early-github</title>
  <style>
    body { font: 14px/1.5 Helvetica, Arial, sans-serif; max-width: 760px; margin: 2em auto; padding: 0 1em; color: #222; }
    header { border-bottom: 1px solid #ddd; margin-bottom: 1.5em; }
    header a { color: #222; text-decoration: none; font-weight: bold; font-size: 1.4em; }
    code, pre { background: #f6f6f6; padding: 2px 4px; }
    pre { padding: 0.8em; overflow-x: auto; }
    .error { color: #b00; }
  </style>
</head>
<body>
  <header><a href="/">early-github</a></header>
  <%= yield %>
</body>
</html>
